# Copy file này thành mail.properties rồi điền thông tin thật. Em không commit mail.properties chứa địa chỉ mail và app password lên git.
# Gmail: bật xác minh 2 bước -> tạo "App password" (16 ký tự) tại https://myaccount.google.com/apppasswords
mail.host=smtp.gmail.com
mail.port=587
mail.username=your_email@gmail.com
mail.password=your_app_password
